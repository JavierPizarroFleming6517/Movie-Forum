generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum ReportType {
  spam
  offensive
  spoiler
  other
}

enum ReportStatus {
  pending
  dismissed
  action_taken
}

enum TargetType {
  review
  reply
}

enum ActionType {
  warn
  delete_content
  ban_temp
  ban_perm
}

/// Existing table from Foro-Peliculas (Alembic). Do not migrate.
model User {
  id                   Int            @id @default(autoincrement())
  email                String         @unique(map: "ix_users_email") @db.VarChar(255)
  username             String         @unique(map: "ix_users_username") @db.VarChar(80)
  hashedPassword       String         @map("hashed_password")
  isActive             Boolean        @default(true) @map("is_active")
  role                 UserRole       @default(user)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  reviews              Review[]
  replies              ReviewReply[]
  reports              Report[]       @relation("UserReports")
  resolvedReports      Report[]       @relation("ResolvedReports")
  moderationActions    ModerationAction[] @relation("ModeratorActions")

  @@map("users")
}

model Pelicula {
  id            Int      @id
  titulo        String   @db.VarChar(255)
  posterUrl     String?  @map("poster_url") @db.VarChar(500)
  detallesExtra Json     @default("{}") @map("detalles_extra")
  reviews       Review[]

  @@index([titulo], map: "ix_peliculas_titulo")
  @@map("peliculas")
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  peliculaId Int      @map("pelicula_id")
  rating     Int
  comment    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User          @relation(fields: [userId], references: [id])
  pelicula   Pelicula      @relation(fields: [peliculaId], references: [id])
  replies    ReviewReply[]

  @@unique([userId, peliculaId], map: "uq_review_user_item")
  @@index([userId], map: "ix_reviews_user_id")
  @@index([peliculaId], map: "ix_reviews_pelicula_id")
  @@map("reviews")
}

model ReviewReply {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @map("review_id")
  userId    Int      @map("user_id")
  comment   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([reviewId], map: "ix_review_replies_review_id")
  @@index([userId], map: "ix_review_replies_user_id")
  @@map("review_replies")
}

model Report {
  id           Int          @id @default(autoincrement())
  type         ReportType
  reason       String       @db.VarChar(500)
  status       ReportStatus @default(pending)
  targetId     Int
  targetType   TargetType
  reporterId   Int
  reporter     User         @relation("UserReports", fields: [reporterId], references: [id])
  resolvedById Int?
  resolvedBy   User?        @relation("ResolvedReports", fields: [resolvedById], references: [id])
  moderationActionId Int?
  moderationAction   ModerationAction? @relation(fields: [moderationActionId], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt   DateTime?    @map("resolved_at") @db.Timestamptz(6)

  @@index([targetId, targetType], map: "ix_reports_target")
  @@index([status], map: "ix_reports_status")
  @@index([createdAt], map: "ix_reports_created_at")
  @@index([reporterId], map: "ix_reports_reporter")
  @@map("reports")
}

model ModerationAction {
  id          Int          @id @default(autoincrement())
  type        ActionType
  targetId    Int
  targetType  TargetType
  moderatorId Int
  moderator   User         @relation("ModeratorActions", fields: [moderatorId], references: [id])
  reason      String?      @db.VarChar(500)
  durationDays Int?
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  reports     Report[]

  @@index([targetId, targetType], map: "ix_moderation_actions_target")
  @@index([moderatorId], map: "ix_moderation_actions_moderator")
  @@index([expiresAt], map: "ix_moderation_actions_expires")
  @@map("moderation_actions")
}
