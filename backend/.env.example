# Host API talks to Docker Postgres on localhost.
# Compose overrides this to postgresql://foro:foro@db:5432/foro_peliculas inside the API container.
DATABASE_URL=postgresql://foro:foro@127.0.0.1:5432/foro_peliculas
SECRET_KEY=dev-secret-change-in-production-foro-peliculas
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TMDB_API_KEY=
PORT=3001
